<mxfile host="Electron" version="26.0.0"><diagram id="config-flow" name="Configuration flow"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="900" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bar1" value="" style="rounded=0;fillColor=#0078D4;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1700" height="8" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;Configuration flow — where every setting lives&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=26;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1660" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Sources on the left, precedence in the middle, consumers on the right; secrets live only in Key Vault or managed identity (docs/13)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="56" width="1660" height="36" as="geometry"/></mxCell><mxCell id="footer" value="RAG Knowledge-Base Pattern | Configuration flow (docs/13) | v1.7.0 | Icons: Microsoft Azure Architecture Icons (V24)" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#8A8886;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="872" width="1660" height="18" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;Sources (you set these)&lt;/b&gt;" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontStyle=1;fontSize=14;spacingTop=8;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;fontColor=#201F1E;fontFamily=Segoe UI;fillColor=#F3F2F1;strokeColor=#605E5C;strokeWidth=1.5;dashed=1;dashPattern=6 4;iconKey=gear;image=data:image/svg+xml,;" vertex="1" parent=