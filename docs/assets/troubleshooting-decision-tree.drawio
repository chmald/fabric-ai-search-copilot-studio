amily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="56" width="1660" height="36" as="geometry"/></mxCell><mxCell id="footer" value="RAG Knowledge-Base Pattern | Troubleshooting decision tree (docs/06) | v1.6.1 | Icons: Microsoft Azure Architecture Icons (V24)" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#8A8886;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="926" width="1660" height="18" as="geometry"/></mxCell><mxCell id="start" value="&lt;b&gt;Cost, throttle or network issue&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Spend, 429s or blocked connections&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;fillColor=#FFFFFF;strokeColor=#605E5C;strokeWidth=1.5;fontSize=12;dashed=0;iconKey=monitor;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="20" y="105" width="300" height="64" as="geometry"/></mxCell><mxCell id="d1" value="Fabric cost spike?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fontColor=#201F1E;fontFamily=Segoe UI;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;spacingLeft=34;spacingRight=34;" vertex="1" parent="1"><mxGeometry x="40" y="205" width="260" height="130" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b&gt;1&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=12;fontColor=#FFFFFF;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=2;fontFamily=Segoe UI;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="221" width="26" height="26" as="geometry"/></mxCell><mxCell id="l1" value="&lt;b&gt;§6.1 Cut Fabric spend&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Pause capacity, set indexer interval to 5–15 min, stop sessions, add budget alerts&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;