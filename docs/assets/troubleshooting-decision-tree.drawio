ght=6;fillColor=#FFFFFF;strokeColor=#605E5C;strokeWidth=1.5;fontSize=12;dashed=0;iconKey=keys;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="20" y="105" width="300" height="64" as="geometry"/></mxCell><mxCell id="d1" value="401 with a WWW-Authenticate: Bearer header?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fontColor=#201F1E;fontFamily=Segoe UI;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;spacingLeft=34;spacingRight=34;" vertex="1" parent="1"><mxGeometry x="40" y="205" width="260" height="130" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b&gt;1&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=12;fontColor=#FFFFFF;fillColor=#5C2D91;strokeColor=#FFFFFF;strokeWidth=2;fontFamily=Segoe UI;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="221" width="26" height="26" as="geometry"/></mxCell><mxCell id="l1" value="&lt;b&gt;§0.1 Send a bearer token&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Scopes: search.azure.com, cognitiveservices.azure.com, storage.azure.com — not an api-key&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;fontSize=11;dashed=0;iconKey=keys;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="20" y="379" width="300" height="130" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#107C10;strokeWidth=2;fontFamily=Segoe UI;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1" target="l1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1_l" value="Yes" style="edgeLabel;ht