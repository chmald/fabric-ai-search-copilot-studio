erticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="90" y="894" width="24" height="24" as="geometry"/></mxCell><mxCell id="t18" value="check order (follow the No arrows)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="120" y="897" width="190" height="20" as="geometry"/></mxCell><mxCell id="lg_yes" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=4;fillColor=#107C10;strokeColor=#107C10;strokeWidth=1;dashed=0;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="330" y="904" width="30" height="4" as="geometry"/></mxCell><mxCell id="t19" value="Yes = symptom matches → fix section" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="366" y="897" width="230" height="20" as="geometry"/></mxCell><mxCell id="lg_no" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=4;fillColor=#605E5C;strokeColor=#605E5C;strokeWidth=1;dashed=0;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="610" y="904" width="30" height="4" as="geometry"/></mxCell><mxCell id="t20" value="No = try the next check" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="646" y="897" width="150" height="20" as="geometry"/></mxCell><mxCell id="t21" value="Fixes are documented procedures in docs/06; no live run is recorded for them." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="830" y="897" width="830" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="auth" name="2 · Auth &amp; deploy