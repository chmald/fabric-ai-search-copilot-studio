ate link and approve it on the Foundry side&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;fontSize=11;dashed=0;iconKey=private-link;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1010" y="379" width="300" height="130" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#107C10;strokeWidth=2;fontFamily=Segoe UI;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d4" target="l4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4_l" value="Yes" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1;fontColor=#107C10;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e4"><mxGeometry x="0.0" y="0.0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="d5" value="Indexer cannot reach Blob over a private endpoint?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fontColor=#201F1E;fontFamily=Segoe UI;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;spacingLeft=34;spacingRight=34;" vertex="1" parent="1"><mxGeometry x="1360" y="205" width="260" height="130" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;5&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=12;fontColor=#FFFFFF;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=2;fontFamily=Segoe UI;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1390" y="221" width="26" height="26" as="geometry"/></mxCell><mxCell id="l5" value="&lt;b&gt;§7.2 Shared private link&lt;/b&gt;