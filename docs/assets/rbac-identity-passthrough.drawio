<mxfile host="Electron" version="26.0.0"><diagram id="rbac-identity" name="RBAC and identity passthrough"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1120" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bar1" value="" style="rounded=0;fillColor=#0078D4;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1700" height="8" as="geometry"/></mxCell><mxCell id="bar2" value="" style="rounded=0;fillColor=#5C2D91;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="935" y="0" width="765" height="8" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;Identity passthrough — who the agent runs as, and what trims the answer&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=26;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1660" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="AI Search runs as the Foundry project managed identity (no user passthrough); the Fabric Data Agent tool runs on-behalf-of the signed-in user (docs/11)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="56" width="1660" height="36" as="geometry"/></mxCell><mxCell id="footer" value="RAG Knowledge-Base Pattern | RBAC and identity passthrough (docs/11) | v1.7.0 | Icons: Microsoft Azure Architecture Icons (V24)" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#8A8886;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="1092" width="1660" height="18" as="geometry"/></mxCell><mxCell id="f0" value="&lt;b&gt;Signed-in user&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Entra SSO in Teams / M365 Copilot&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap