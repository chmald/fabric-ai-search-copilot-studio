s="geometry"></mxGeometry></mxCell><mxCell id="e4_l" value="message" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1;fontColor=#0078D4;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e4"><mxGeometry x="0.0" y="0.0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#0078D4;strokeWidth=2;fontFamily=Segoe UI;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="f2" target="f3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5_l" value="invoke agent" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1;fontColor=#0078D4;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e5"><mxGeometry x="0.0" y="0.0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="path1" value="&lt;b&gt;Path 1 · AI Search tool — project managed identity&lt;/b&gt;" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontStyle=1;fontSize=14;spacingTop=8;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;fontColor=#201F1E;fontFamily=Segoe UI;fillColor=#EEF8F8;strokeColor=#038387;strokeWidth=1.5;dashed=1;dashPattern=6 4;iconKey=ai-search;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="20" y="230" width="820" height="250" as="geometry"/></mxCell><mxCell id="t1" value="&lt;b&gt;Azure AI Search tool&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;runs as the project MI — no user passthrough&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;fillColor=#FFFFFF;strokeColor=#038387;strokeWidth=1.5;fontSize=12;dashed=0;iconKey=ai-search;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="285" width="330" height="80" as="geometry"/></mxCell><mxCell id="i1" value="&lt;b&gt;idx-rag-documents&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;chunks carry group_ids&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;fillColor=#FFFFFF;strokeColor=#038387;strokeWidth=1.5;fontSize=12;dashed=0;iconKey=ai-search;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="480" y="285" width="340" height="80" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#038387;strokeWidth=2;fontFamily=Segoe UI;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t1" target="i1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6_l" value="query" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1;fontColor=#038387;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e6"><mxGeometry x="0.0" y="0.0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="t7" value="• The agent must inject &lt;b&gt;group_ids/any(g: search.in(g, &#x27;&amp;lt;caller group IDs&amp;gt;&#x27;))&lt;/b&gt; — the index never sees the user&lt;br&gt;• Trimming is enforced by the agent, not by Azure RBAC&lt;br&gt;• Copilot Studio instead uses a connection with Search Index Data Reader" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="385" width="780" height="90" as="geometry"/></mxCell><mxCell id="path2" value="&lt;b&gt;Path 2 · Fabric Data Agent tool — on-behalf-of (OBO)&lt;/b&gt;" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontStyle=1;fontSize=14;spacingTop=8;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;fontColor=#201F1E;fontFamily=Segoe UI;fillColor=#F5F0FA;strokeColor=#5C2D91;strokeWidth=1.5;dashed=1;dashPattern=6 4;iconKey=toolbox;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="860" y="230" width="820" height="250" as="geometry"/></mxCell><mxCell id="t2" value="&lt;b&gt;Fabric Data Agent tool&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;user token exchanged (OBO) · read-only&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=12;dashed=0;iconKey=toolbox;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="880" y="285" width="330" height="80" as="geometry"/></mxCell><mxCell id="i2" value="&lt;b&gt;Fabric data&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Lakehouse · Warehouse · semantic model · KQL&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=12;dashed=0;iconKey=folder;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1320" y="285" width="340" height="80" as="geometry"/></mxCell><mxCell id="pl8" value="PREVIEW" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=9;fontStyle=1;fontColor=#FFFFFF;fillColor=#CA5010;strokeColor=#FFFFFF;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1136" y="276" width="70" height="18" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#5C2D91;strokeWidth=2;fontFamily=Segoe UI;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t2" target="i2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9_l" value="as the user" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1;fontColor=#5C2D91;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e9"><mxGeometry x="0.0" y="0.0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="t10" value="• Fabric enforces RLS / OLS / Purview labels / DLP natively for the signed-in user&lt;br&gt;• Service principal is not supported — every end user needs Fabric grants&lt;br&gt;• End user: Read on the data agent + Lakehouse Read, semantic model Build, Warehouse SELECT, KQL Reader" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="880" y="385" width="780" height="90" as="geometry"/></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#038387;strokeWidth=2;fontFamily=Segoe UI;dashed=1;dashPattern=6 4;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f3" target="path1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11_l" value="tool call" style="edg