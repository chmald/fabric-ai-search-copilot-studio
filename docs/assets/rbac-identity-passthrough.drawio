imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=11;dashed=0;iconKey=ai-search;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="525" height="78" as="geometry"/></mxCell><mxCell id="r1" value="&lt;b&gt;Foundry resource MI&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Storage Blob Data Reader (Document Intelligence reads blobs by URL)&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=11;dashed=0;iconKey=foundry;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="585" y="560" width="525" height="78" as="geometry"/></mxCell><mxCell id="r2" value="&lt;b&gt;Fabric workspace identity&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Storage Blob Data Contributor · Key Vault Secrets User&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=11;dashed=0;iconKey=managed-identity;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1130" y="560" width="525" height="78" as="geometry"/></mxCell><mxCell id="r3" value="&lt;b&gt;sp-rag-di-caller&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Cognitive Services User on Foundry (Fabric notebook → Document Intelligence)&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=