<mxCell id="n73" value="&lt;b&gt;Fabric constraints:&lt;/b&gt; the pipeline has no Web activity and no Until loop, so Document Intelligence is called inside nb_ocr_chunk_upload (workspace identity for Blob, MSAL for Document Intelligence). It runs with _inlineInstallationEnabled=true and writes chunk JSON to the chunks/ container." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFFDF5;strokeColor=#C8A400;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=44;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="820" height="90" as="geometry"/></mxCell>
<mxCell id="n74" value="i" style="ellipse;whiteSpace=wrap;html=1;fillColor=#C8A400;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="52" y="914" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="n75" value="&lt;b&gt;Handoff:&lt;/b&gt; the AI Search indexer picks up chunks/ within ~5 min (Phase 4 in docs/03)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFFDF5;strokeColor=#C8A400;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=44;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1330" y="880" width="390" height="90" as="geometry"/></mxCell>
<mxCell id="n76" value="i" style="ellipse;whiteSpace=wrap;html=1;fillColor=#C8A400;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1342" y="914" width="22" height="22" as="geometry"/></mxCell>
<mxCell id="n77" value="&lt;b&gt;Sources:&lt;/b&gt; via OneLake shortcut: SharePoint Online, ADLS Gen2, Blob, S3, GCS. File share, FTP and mailbox: scheduled Copy data into Files/source_docs/. &lt;b&gt;Tenant settings (F0.1):&lt;/b&gt; create Fabric items, OneLake shortcuts, workspace identity API access, Data Factory pipelines. &lt;b&gt;Finish:&lt;/b&gt; work through the 17-item final checklist in docs/03b." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFFDF5;strokeColor=#C8A400;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=44;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="20" y="1010" width="1720" height="70" as="geometry"/></mxCell>
