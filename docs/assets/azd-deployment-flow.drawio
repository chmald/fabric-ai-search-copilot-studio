<mxfile host="Electron" version="26.0.0"><diagram id="azd-flow" name="azd up flow"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="800" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bar1" value="" style="rounded=0;fillColor=#0078D4;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1700" height="8" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;azd up — one command over the shared Bicep&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=26;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1660" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Authenticate both CLIs, set the environment, then azd runs preprovision guards, provisions infra/azd.bicep → main.bicep, and postprovision writes the ids file and configures AI Search (docs/03)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="56" width="1660" height="36" as="geometry"/></mxCell><mxCell id="footer" value="RAG Knowledge-Base Pattern | azd up flow (docs/03) | v1.7.0 | Icons: Microsoft Azure Architecture Icons (V24)" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#8A8886;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="772" width="1660" height="18" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;0 · Authenticate&lt;/b&gt;" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontStyle=1;fontSize=14;spacingTop=8;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;fontColor=#201F1E;fontFamily=Segoe UI;fillColor=#F3F2F1;strokeColor=#605E5C;strokeWidth=1.5;dashed=1;dashPattern=6 4;iconKey=entra-id;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="300" height="500" as="geometry"/></mxCell><mxCell id="t2" value="&lt;b&gt;azd auth login&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;--tenant-id &amp;lt;tenant&amp;gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;azd's own login&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;fillColor=#FFFFFF;strokeColor=#605E5C;strokeWidth=1.5;fontSize=12;dashed=0;iconKey=entra-id;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="260" height="84" as="geometry"/></mxCell><mxCell id="t3" value="&lt;b&gt;az login + account set&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;--tenant, --subscription&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;the hooks and scripts use az&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;fillColor=#FFFFFF;strokeColor=#605E5C;strokeWidth=1.5;fontSize=12;dashed=0;iconKey=subscription;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="260" height="84" as="geometry"/></mxCell><mxCell id="t4" value="&lt;b&gt;azd env new / env set&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;AZURE_TENANT_ID, AZURE_SUBSCRIPTION_ID&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;AZURE_LOCATION + knobs (docs/13)&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;fillColor=#FFFFFF;strokeColor=#605E5C;strokeWidth=1.5;fontSize=12;dashed=0;iconKey=gear;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="260" height="96" as="geometry"/></mxCell><mxCell id="t5" value="&lt;b&gt;azd provision --preview&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;plan only, no changes&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;fillColor=#FFFFFF;strokeColor=#605E5C;strokeWidth=1.5;fontSize=12;dashed=0;iconKey=code;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="260" height="84" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#605E5C;strokeWidth=2;fontFamily=Segoe UI;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="t2" target="t3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#605E5C;strokeWidth=2;fontFamily=Segoe UI;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="t3" target="t4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#605E5C;strokeWidth=2;fontFamily=Segoe UI;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="t4" target="t5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s9" value="&lt;b&gt;1 · preprovision hook&lt;/b&gt;" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontStyle=1;fontSize=14;spacingTop=8;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;fontColor=#201F1E;fontFamily=Segoe UI;fillColor=#EFF6FC;strokeColor=#0078D4;strokeWidth=1.5;dashed=1;dashPattern=6 4;iconKey=powershell;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="360" y="110" width="400" height="500" as="geometry"/></mxCell><mxCell id="t10" value="&lt;b&gt;Name guards&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;AZURE_ENV_NAME ≤ 20, lowercase&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;WORKLOAD_NAME → storage name ≤ 24&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=12;dashed=0;iconKey=gear;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="380" y="160" width="360" height="84" as="geometry"/></mxCell><mxCell id="t11" value="&lt;b&gt;Tenant / subscription guard&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;stops unless az account show matches&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;AZURE_TENANT_ID + AZURE_SUBSCRIPTION_ID&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=12;dashed=0;iconKey=entra-id;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="380" y="270" width="360" height="84" as="geometry"/></mxCell><mxCell id="t12" value="&lt;b&gt;Soft-delete guard&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Foundry: restore in place&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Key Vault: recover · PURGE_SOFT_DELETED=true purges&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=12;dashed=0;iconKey=key-vault;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="380" y="380" width="360" height="96" as="geometry"/></mxCell><mxCell id="n13" value="• Sets RESTORE_FOUNDRY_FROM_SOFT_DELETE to match reality&lt;br&gt;• Validates SEARCH_SKU and model SKUs&lt;br&gt;• Shared code: infra/hooks/common.ps1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="380" y="500" width="360" height="80" as="geometry"/></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#0078D4;strokeWidth=2;fontFamily=Segoe UI;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="t10" target="t11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#0078D4;strokeWidth=2;fontFamily=Segoe UI;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="t11" target="t12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s16" value="&lt;b&gt;2 · provision&lt;/b&gt;" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontStyle=1;fontSize=14;spacingTop=8;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;fontColor=#201F1E;fontFam