201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=12;dashed=0;iconKey=foundry;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="820" y="380" width="380" height="96" as="geometry"/></mxCell><mxCell id="t20" value="&lt;b&gt;Outputs → .azure/&amp;lt;env&amp;gt;/.env&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;UPPER_SNAKE_CASE, e.g. SEARCH_ENDPOINT&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=12;dashed=0;iconKey=file;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="820" y="500" width="380" height="84" as="geometry"/></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#5C2D91;strokeWidth=2;fontFamily=Segoe UI;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="t17" target="t18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#5C2D91;strokeWidth=2;fontFamily=Segoe UI;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="t18" target="t19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#5C2D91;strokeWidth=2;fontFamily=Segoe UI;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy