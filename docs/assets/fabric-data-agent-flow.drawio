<mxfile host="Electron" version="26.0.0"><diagram id="fabric-flow" name="Fabric Data Agent flow"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="780" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bar1" value="" style="rounded=0;fillColor=#0078D4;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1620" height="8" as="geometry"/></mxCell><mxCell id="bar2" value="" style="rounded=0;fillColor=#5C2D91;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="891" y="0" width="729" height="8" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;Fabric Data Agent — structured HR data for the Foundry agent&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=26;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1580" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="CSV → Lakehouse Delta tables → Data Agent → Publish → called by the Foundry agent&#x27;s Fabric tool as the signed-in user (09, Foundry path only)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="56" width="1580" height="36" as="geometry"/></mxCell><mxCell id="footer" value="RAG Knowledge-Base Pattern | Fabric Data Agent flow (docs/09) | v1.7.0 | Icons: Microsoft Azure Architecture Icons (V24)" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#8A8886;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="752" width="1580" height="18" as="geometry"/></mxCell><mxCell id="pl1" value="OPTIONAL" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=9;fontStyle=1;fontColor=#FFFFFF;fillColor=#605E5C;strokeColor=#FFFFFF;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1500" y="26" width="70" height="18" as="geometry"/></mxCell><mxCell id="g1" value="&lt;b&gt;G1 · Load tables&lt;/b&gt;" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontStyle=1;fontSize=14;spacingTop=8;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;fontColor=#201F1E;fontFamily=Segoe UI;fillColor=#EFF6FC;strokeColor=#0078D4;strokeWidth=1.5;dashed=1;dashPattern=6 4;iconKey=folder;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="290" height="285" as="geometry"/></mxCell><mxCell id="gt1" value="&lt;b&gt;employees + agreements&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;CSV → Delta tables in lh_rag_&amp;lt;env&amp;gt;&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=12;dashed=0;iconKey=folder;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="164" width="250" height="84" as="geometry"/></mxCell><mxCell id="t2" value="• Upload samples/structured CSVs to Files/structured/&lt;br&gt;• Load to Tables → New table, or a one-cell Spark notebook&lt;br&gt;• Check counts: employees 15 · agreements 30" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="262" width="250" height="140" as="geometry"/></mxCell><mxCell id="g2" value="&lt;b&gt;G2 · Create the agent&lt;/b&gt;" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontStyle=1;fontSize=14;spacingTop=8;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;fontColor=#201F1E;fontFamily=Segoe UI;fillColor=#EFF6FC;strokeColor=#0078D4;strokeWidth=1.5;dashed=1;dashPattern=6 4;iconKey=toolbox;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="340" y="110" width="290" height="285" as="geometry"/></mxCell><mxCell id="gt2" value="&lt;b&gt;data-agent-hr&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Fabric Data Agent over the two tables&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=12;dashed=0;iconKey=toolbox;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="360" y="164" width="250" height="84" as="geometry"/></mxCell><mxCell id="t3" value="• + New item → Data agent&lt;br&gt;• Data source: Lakehouse lh_rag_&amp;lt;env&amp;gt;&lt;br&gt;• Select the employees + agreements tables&lt;br&gt;• Confirm both schemas in the schema pane" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="360" y="262" width="250" height="140" as="geometry"/></mxCell><mxCell id="g3" value="&lt;b&gt;G3 · Ground it&lt;/b&gt;" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontStyle=1;fontSize=14;spacingTop=8;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;fontColor=#201F1E;fontFamily=Segoe UI;fillColor=#EFF6FC;strokeColor=#0078D4;strokeWidth=1.5;dashed=1;dashPattern=6 4;iconKey=file;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="660" y="110" width="290" height="285" as="geometry"/></mxCell><mxCell id="gt3" value="&lt;b&gt;Instructions + examples&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Guides NL-to-query accuracy&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=12;dashed=0;iconKey=file;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="680" y="164" width="250" height="84" as="geometry"/></mxCell><mxCell id="t4" value="• Filter on amount_basis (annual / hourly / lump_sum / fixed_fee / milestone) before averaging&lt;br&gt;• Do not convert currency&lt;br&gt;• Examples: 2 exec offers · 191,500 USD avg US senior · 15/5/5/5 doc types · SEV-002, SEV-005 · DE list" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="680" y="262" width="250" height="140" as="geometry"/></mxCell><mxCell id="g4" value="&lt;b&gt;G4 · Test in Fabric&lt;/b&gt;" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontStyle=1;fontSize=14;spacingTop=8;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;fontColor=#201F1E;fontFamily=Segoe UI;fillColor=#EFF6FC;strokeColor=#0078D4;strokeWidth=1.5;dashed=1;dashPattern=6 4;iconKey=dev-console;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="980" y="110" width="290" height="285" as="geometry"/></mxCell><mxCell id="gt4" value="&lt;b&gt;Chat pane&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Run the example questions&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=12;dashed=0;iconKey=dev-console;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1000" y="164" width="250" height="84" as="geometry"/></mxCell><mxCell id="t5" value=