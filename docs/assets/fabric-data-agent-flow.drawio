eometry"/></mxCell><mxCell id="nt17" value="&lt;b&gt;Identity&lt;/b&gt;&lt;br&gt;The Foundry Fabric tool uses user identity (OBO) only — service principal is not supported — so every end user needs those grants. Optional: demonstrate per-user trimming with row-level security." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFDF5;strokeColor=#C8A400;dashed=1;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="820" y="620" width="780" height="80" as="geometry"/></mxCell><mxCell id="lg18" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="716" width="60" height="18" as="geometry"/></mxCell><mxCell id="pl19" value="GA" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=9;fontStyle=1;fontColor=#FFFFFF;fillColor=#107C10;strokeColor=#FFFFFF;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="90" y="716" width="44" height="18" as="geometry"/></mxCell><mxCell id="t20" value="generally available" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="138" y="715" width="120" height="20" as="geometry"/></mxCell><mxCell id="pl21" value="PREVIEW" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=9;fontStyle=1;fontColor=#FFFFFF;fillColor=#CA5010;strokeColor=#FFFFFF;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="272" y="716" width="79" height="18" as="geometry"/></mxCell><mxCell id="t22" value="preview feature" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="355" y="715" width="98" height="20" as="geometry"/></mxCell><mxCel