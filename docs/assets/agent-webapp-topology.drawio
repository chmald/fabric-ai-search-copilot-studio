6" y="341" width="70" height="18" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#5C2D91;strokeWidth=2;fontFamily=Segoe UI;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="app" target="proj"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8_l" value="agent call" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1;fontColor=#5C2D91;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e8"><mxGeometry x="0.0" y="0.0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#5C2D91;strokeWidth=2;fontFamily=Segoe UI;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="proj" target="ag"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#5C2D91;strokeWidth=2;fontFamily=Segoe UI;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ag" target="ts"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#5C2D91;strokeWidth=2;fontFamily=Segoe UI;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ag" target="tf"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mi" value="&lt;b&gt;MI mode (default)&lt;/b&gt;" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontStyle=1;fontSize=14;spacingTop=8;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;fontColor=#201F1E;fontFamily=Segoe UI;fillColor=#EEF8F8;strokeColor=#038387;strokeWidth=1.5;dashed=1;dashPattern=6 4;iconKey=managed-identity;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="20" y="500" width="830" height="170" as="geometry"/></mxCell><mxCell id="pl12" value="DEFAULT" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=9;fontStyle=1;fontColor=#FFFFFF;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="508" width="66" height="18" as="geometry"/></mxCell><mxCell id="t13" value="• The app calls the agent as the Container App&#x27;s user-assigned managed identity&lt;br&gt;• Works for the AI Search tool&lt;br&gt;• The Fabric tool fails — there is no user identity to exchange&lt;br&gt;• End users need no Azure roles: the UAMI holds Foundry User" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="550" width="790" height="110" as="geometry"/></mxCell><mxCell id="obo" value="&lt;b&gt;OBO mode (opt-in)&lt;/b&gt;" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontStyle=1;fontSize=14;spacingTop=8;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;fontColor=#201F1E;fontFamily=Segoe UI;fillColor=#F5F0FA;strokeColor=#5C2D91;strokeWidth=1.5;dashed=1;dashPattern=6 4;iconKey=entra-workload-id;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="870" y="500" width="810" height="170" as="geometry"/></mxCell><mxCell id="pl14" value="OPT-IN" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=9;fontStyle=1;fontColor=#FFFFFF;fillColor=#5C2D91;strokeColor=#FFFFFF;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1590" y="508" width="60" height="18" as="geometry"/></mxCell><mxCell id="t15" value="• &lt;b&gt;OnBehalfOfCredential&lt;/b&gt; + a backend Entra app registration&lt;br&gt;• Federated identity credential trusts the app MI — no client secret&lt;br&gt;• Container Apps authentication signs the user in&lt;br&gt;• Needs admin consent + a delegated permission (user_impersonation)&lt;br&gt;• Enable with scripts/deploy-webapp.ps1 -EnableObo" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="890" y="550" width="770" height="110" as="geometry"/></mxCell><mxCell id="dep" value="&lt;b&gt;Build and deploy — scripts/deploy-webapp.ps1 (-EnableObo, -WhatIf)&lt;/b&gt;" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontStyle=1;fontSize=14;spacingTop=8;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;fontColor=#201F1E;fontFamily=Segoe UI;fillColor=#F8F7F6;strokeColor=#605E5C;strokeWidth=1.5;dashed=1;dashPattern=6 4;iconKey=powershell;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="20" y="700" width="830" height="150" as="geometry"/></mxCell><mxCell id="d1" value="&lt;b&gt;deploy-webapp.ps1&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;-WhatIf previews&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;fillColor=#FFFFFF;strokeColor=#605E5C;strokeWidth=1.5;fontSize=11;dashed=0;iconKey=powershell;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="748" width="240" height="80" as="geometry"/></mxCell><mxCell id="d2" value="&lt;b&gt;az acr build&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;image built in ACR&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;fillColor=#FFFFFF;strokeColor=#605E5C;strokeWidth=1.5;fontSize=11;dashed=0;iconKey=container-registry;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="310" y="748" width="250" height="80" as="geometry"/></mxCell><mxCell id="d3" value="&lt;b&gt;New revision&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Container App updated&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;fillColor=#FFFFFF;strokeColor=#605E5C;strokeWidth=1.5;fontSize=11;dashed=0;iconKey=container-apps;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="590" y="748" width="240" height="80" as="geometry"/></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#605E5C;strokeWidth=2;fontFamily=Segoe UI;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1" target="d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#605E5C;strokeWidth=2;fontFamily=Segoe UI;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d2" target="d3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="nt18" value="&lt;b&gt;Roles:&lt;/b&gt; UAMI — AcrPull, Foundry User, Cognitive Services OpenAI Contributor. End users — a Foundry data-plane role + Fabric Read.&lt;br&gt;&lt;b&gt;Caveats:&lt;/b&gt; azure-ai-projects v1.x (threads/runs) = classic agents, retiring 2027-03-31 — migrate to the 2.x Responses API · Conditional Access can interfere with OBO · AI Search group_ids trimming stays separate even in OBO.&lt;br&gt;&lt;b&gt;Front ends:&lt;/b&gt; Copilot Studio channel · Foundry portal publish (Teams/M365, GA) · this standalone web app." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFDF5;strokeColor=#C8A400;dashed=1;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="870" y="700" width="810" height="150" as="geometry"/></mxCell><mxCell id="lg19" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="872" width="60" height="18" as="geometry"/></mxCell><mxCell id="pl20" value="DEFAULT" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=9;fontStyle=1;fontColor=#FFFFFF;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="90" y="872" width="79" height="18" as="geometry"/></mxCell><mxCell id="t21" value="managed-identity mode" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="173" y="871" width="131" height="20" as="geometry"/></mxCell><mxCell id="pl22" value="OPT-IN" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=9;fontStyle=1;fontColor=#FFFFFF;fillColor=#5C2D91;strokeColor=#FFFFFF;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="318" y="872" width="70" height="18" as="geometry"/></mxCell><mxCell id="t23" value="on-behalf-of mode" styl