<mxCell id="n58" value="&lt;b&gt;Total time:&lt;/b&gt; Azure-only manual build takes about 2–3 h; the full demo including Fabric takes 4–6 h. The Fabric phases are manual in every case: there is no Bicep or ARM for Fabric." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFFDF5;strokeColor=#C8A400;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=44;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="20" y="890" width="1720" height="60" as="geometry"/></mxCell>
