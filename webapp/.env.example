# Foundry agent web app — runtime configuration (reference / local run)
#
# In Azure these values are set on the Container App by scripts/deploy-webapp.ps1.
# For a LOCAL run, export them in your shell (see webapp/README.md). Never commit a
# populated .env — it is gitignored.

# --- Agent the app talks to (from docs/03d) ---
FOUNDRY_PROJECT_ENDPOINT="https://<resource>.services.ai.azure.com/api/projects/<project>"
AGENT_ID="<agent-id>"

# Token scope/audience for the Foundry data plane (verify against Microsoft Learn).
AGENT_TOKEN_SCOPE="https://ai.azure.com/.default"

# Client ID of the app's user-assigned managed identity (Azure runtime).
AZURE_CLIENT_ID="<managed-identity-client-id>"

# --- On-Behalf-Of (per-user passthrough; required for the Fabric data agent tool) ---
# "true" calls the agent as the signed-in user. Requires the Entra app registration +
# federated credential + Container Apps authentication created by
# scripts/deploy-webapp.ps1 -EnableObo. Leave "false" for an AI-Search-only agent.
ENABLE_OBO="false"
OBO_CLIENT_ID="<obo-app-registration-client-id>"
AZURE_TENANT_ID="<tenant-id>"
