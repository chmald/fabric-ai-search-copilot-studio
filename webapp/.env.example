# Foundry agent web app — deployment configuration (OBO mode)
#
# Copy this file to `webapp/.env` and fill in the values for the agent you built
# in docs/03d. NEVER commit the populated `.env` (it is gitignored).
#
# Values come from the Microsoft Foundry portal (or your 03d notes).

# --- Agent the web app talks to -------------------------------------------------

# Agent name + version, e.g. hr-knowledge-agent:2
AZURE_EXISTING_AGENT_ID="<agent-name>:<version>"

# Project endpoint, e.g. https://<resource>.services.ai.azure.com/api/projects/<project>
AZURE_EXISTING_AIPROJECT_ENDPOINT="https://<resource>.services.ai.azure.com/api/projects/<project>"

# Foundry account (resource) ID
AZURE_EXISTING_RESOURCE_ID="/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<resource>"

# --- On-Behalf-Of (identity passthrough) ---------------------------------------

# REQUIRED when the agent uses the Microsoft Fabric data agent tool, so the
# signed-in user's identity flows to the agent and Fabric enforces RLS/OLS per
# user. Set to false only for an AI-Search-only agent (MI mode is then enough).
#
# NOTE: confirm the exact azd parameter name/casing in the upstream
# "Advanced: On-Behalf-Of (OBO) — opt-in" section before deploying.
ENABLE_OBO="true"

# --- Optional ------------------------------------------------------------------

# Azure region for the deployment (leave blank to let azd prompt).
AZURE_LOCATION=""

# If your org requires a Service Management Reference for Entra app registrations.
ENTRA_SERVICE_MANAGEMENT_REFERENCE=""
